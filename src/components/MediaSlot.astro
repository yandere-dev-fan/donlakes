---
/**
 * MediaSlot — единая точка подстановки медиа (раздел 2 спеки).
 *
 * Пока реального файла нет — рисует нейтральную заглушку с id и пропорциями.
 * Контейнер ВСЕГДА задаёт aspect-ratio → подстановка реального файла не вызывает
 * скачков вёрстки. Пропорции слотов фиксируются сейчас и не меняются (раздел 9).
 *
 * Когда появятся файлы: сюда добавится srcset/<picture>, blur-up и lazy —
 * разметка-обёртка и aspect-ratio останутся прежними.
 */
interface Props {
  id: string;
  ratio: string; // напр. "16/9", "4/3", "3/4", "21/9", "1/1"
  type?: 'image' | 'video';
  src?: string; // путь к реальному файлу (пока обычно не задан)
  priority?: boolean; // приоритетная загрузка (только первый экран)
  alt?: string;
  class?: string;
  rounded?: boolean;
  overlay?: boolean; // градиентное затемнение поверх (для текста на медиа)
}

const {
  id,
  ratio,
  type = 'image',
  src,
  priority = false,
  alt = '',
  class: className = '',
  rounded = true,
  overlay = false,
} = Astro.props;

const ratioCss = ratio.replace('/', ' / ');
const loading = priority ? 'eager' : 'lazy';
---

<figure
  class:list={['media-slot', { 'media-slot--rounded': rounded, 'media-slot--overlay': overlay }, className]}
  style={`--ratio: ${ratioCss};`}
  data-media-id={id}
  role={alt ? 'img' : 'presentation'}
  aria-label={alt || undefined}
>
  {
    src ? (
      type === 'video' ? (
        <video
          class="media-slot__media"
          src={src}
          autoplay
          muted
          loop
          playsinline
          preload={priority ? 'auto' : 'metadata'}
          aria-hidden="true"
        />
      ) : (
        <img class="media-slot__media" src={src} alt={alt} loading={loading} decoding="async" />
      )
    ) : (
      <div class="media-slot__placeholder" aria-hidden="true">
        <span class="media-slot__badge">{type === 'video' ? '▶ ' : ''}{id}</span>
        <span class="media-slot__ratio">{ratio}</span>
      </div>
    )
  }
  {overlay && <div class="media-slot__gradient" aria-hidden="true"></div>}
</figure>

<style>
  .media-slot {
    position: relative;
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    background: var(--color-surface-warm);
    margin: 0;
  }
  .media-slot--rounded {
    border-radius: var(--radius-md);
  }
  .media-slot__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Заглушка: диагональная штриховка + подпись id/пропорций */
  .media-slot__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px;
    text-align: center;
    color: var(--color-muted);
    background-color: var(--color-surface);
    background-image:
      radial-gradient(120% 90% at 50% 0%, rgba(201, 138, 75, 0.08), transparent 60%),
      repeating-linear-gradient(
        -45deg,
        rgba(246, 239, 223, 0.04) 0 10px,
        rgba(246, 239, 223, 0) 10px 20px
      );
  }
  .media-slot__badge {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text);
    opacity: 0.7;
    word-break: break-all;
    line-height: 1.3;
  }
  .media-slot__ratio {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    opacity: 0.5;
  }

  .media-slot__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--overlay-top) 0%, transparent 30%),
      linear-gradient(to top, var(--overlay-bottom) 0%, transparent 55%);
    pointer-events: none;
  }
</style>
