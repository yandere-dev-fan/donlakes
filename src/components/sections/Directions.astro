---
import DirectionIcon from '../DirectionIcon.astro';
import directions from '../../content/directions.json';
---
<section id="services" class="dirs section" aria-labelledby="dirs-title">
  <div class="container">
    <header class="dirs__head">
      <p class="eyebrow" data-reveal>Что у нас есть</p>
      <h2 id="dirs-title" class="dirs__title" data-reveal data-reveal-delay="60">
        Всё для отдыха на природе — в одном месте
      </h2>
    </header>

    <ul class="dirs__grid" data-reveal-group data-reveal-delay="60">
      {directions.map((d) => (
        <li class="dirs__item" data-reveal>
          <a class="dirs__tile" href={d.href}>
            <span class="dirs__icon">
              <DirectionIcon name={d.key} />
            </span>
            <span class="dirs__name">{d.name}</span>
            <span class="dirs__short">{d.short}</span>
            <span class="dirs__arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .dirs__head { max-width: 640px; margin-bottom: clamp(28px, 5vw, 52px); }
  .dirs__title { font-size: var(--step-3); margin-top: 12px; }

  .dirs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 768px) {
    .dirs__grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
  }
  @media (min-width: 1024px) {
    .dirs__grid { grid-template-columns: repeat(6, 1fr); }
  }

  .dirs__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 18px 16px 20px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
    will-change: transform;
  }
  .dirs__tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
  }

  .dirs__icon {
    width: 40px;
    height: 40px;
    color: var(--color-accent);
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .dirs__tile:hover .dirs__icon {
    transform: scale(1.08) rotate(-3deg);
    color: var(--color-cta);
  }

  .dirs__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .dirs__short {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.35;
  }
  .dirs__arrow {
    margin-top: auto;
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .dirs__tile:hover .dirs__arrow { opacity: 1; transform: translateX(0); }

  @media (prefers-reduced-motion: reduce) {
    .dirs__tile:hover, .dirs__tile:hover .dirs__icon { transform: none; }
    .dirs__arrow { opacity: 1; transform: none; }
  }
</style>
