---
import MediaSlot from '../MediaSlot.astro';
import site from '../../content/site.json';
import cottages from '../../content/cottages.json';

const priceFmt = (n: number) => n.toLocaleString('ru-RU');
---
<section id="cottages" class="cots section section--warm" aria-labelledby="cots-title">
  <div class="container">
    <header class="cots__head">
      <p class="eyebrow" data-reveal>Размещение</p>
      <h2 id="cots-title" class="cots__title" data-reveal data-reveal-delay="60">Где вы будете жить</h2>
      <p class="cots__lead" data-reveal data-reveal-delay="120">
        Две категории домиков — от лёгкого летнего варианта до сруба со всеми удобствами.
      </p>
    </header>

    <ul class="cots__grid" data-reveal-group data-reveal-delay="120">
      {cottages.map((c) => (
        <li class="cot" data-reveal>
          <a class="cot__link" href={`/domiki/${c.slug}`} aria-label={`${c.name} — подробнее`}>
            <div class="cot__media" data-reveal>
              <MediaSlot id={`${c.mediaPrefix}/cover`} ratio="4/3" alt={c.name} rounded={false} />
              <span class="cot__curtain" aria-hidden="true"></span>
              <span class="cot__badge">{c.capacityLabel}</span>
            </div>

            <div class="cot__body">
              <h3 class="cot__name">{c.name}</h3>
              <p class="cot__desc">{c.shortDescription}</p>

              <ul class="cot__amenities">
                {c.keyAmenities.map((a) => (
                  <li>
                    <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>
                    {a}
                  </li>
                ))}
              </ul>

              <div class="cot__foot">
                <span class="cot__price">
                  <span class="cot__price-label">от</span>
                  <span class="cot__price-val">{priceFmt(c.priceFrom)}&nbsp;₽</span>
                  <span class="cot__price-unit">в сутки</span>
                </span>
                <span class="cot__more">
                  Подробнее
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="cots__cta" data-reveal>
      <p>Не знаете, какой выбрать? Позвоните — подскажем и забронируем.</p>
      <a class="cots__phone" href={`tel:${site.phoneRaw}`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg>
        {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cots__head { max-width: 620px; margin-bottom: clamp(28px, 5vw, 52px); }
  .cots__title { font-size: var(--step-3); margin-top: 12px; }
  .cots__lead { margin-top: 14px; color: var(--color-muted); font-size: var(--step-1); }

  .cots__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .cots__grid { grid-template-columns: repeat(2, 1fr); gap: 28px; }
  }
  @media (min-width: 1024px) {
    .cots__grid { grid-template-columns: repeat(2, 1fr); gap: 32px; max-width: 980px; }
  }

  .cot { height: 100%; }
  .cot__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    will-change: transform;
  }
  .cot__link:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  /* Медиа-маска: base (data-reveal) не должен затемнять сам блок — переопределяем */
  .cot__media[data-reveal] { opacity: 1; transform: none; }
  .cot__media {
    position: relative;
    overflow: hidden;
  }
  .cot__media :global(.media-slot) {
    transform: scale(1.08);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .cot__media.is-visible :global(.media-slot) { transform: scale(1); }
  .cot__link:hover .cot__media :global(.media-slot) { transform: scale(1.06); }

  /* Штора, уезжающая вверх при появлении */
  .cot__curtain {
    position: absolute;
    inset: 0;
    background: var(--color-surface-warm);
    transform: translateY(0);
    transition: transform var(--dur-slow) var(--ease-out);
    z-index: 2;
  }
  .cot__media.is-visible .cot__curtain { transform: translateY(-101%); }

  .cot__badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 3;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-ink) 72%, transparent);
    backdrop-filter: blur(4px);
    color: var(--on-media);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cot__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px clamp(18px, 3vw, 28px) 24px;
    flex: 1;
  }
  .cot__name { font-size: var(--step-2); }
  .cot__desc { color: var(--color-muted); font-size: 0.95rem; }

  .cot__amenities {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }
  .cot__amenities li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.92rem;
  }
  .cot__amenities svg { color: var(--color-accent); flex-shrink: 0; }

  .cot__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }
  .cot__price { display: flex; flex-direction: column; line-height: 1.15; }
  .cot__price-label { font-size: 0.75rem; color: var(--color-muted); }
  .cot__price-val { font-family: var(--font-display); font-size: 1.7rem; font-weight: 600; color: var(--color-text); }
  .cot__price-unit { font-size: 0.75rem; color: var(--color-muted); }
  .cot__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.95rem;
    transition: gap var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .cot__link:hover .cot__more { gap: 11px; color: var(--color-cta); }

  .cots__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(32px, 5vw, 56px);
    padding: clamp(22px, 4vw, 34px);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .cots__cta p { font-size: var(--step-1); font-weight: 500; max-width: 34ch; }
  .cots__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0.85em 1.6em;
    border-radius: var(--radius-pill);
    background: var(--color-cta);
    color: var(--on-media);
    font-weight: 700;
    font-size: var(--step-1);
    white-space: nowrap;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .cots__phone:hover { background: var(--color-cta-hover); transform: translateY(-2px); }

  @media (prefers-reduced-motion: reduce) {
    .cot__media :global(.media-slot),
    .cot__link:hover .cot__media :global(.media-slot) { transform: none; }
    .cot__curtain { display: none; }
    .cot__link:hover { transform: none; }
    .cots__phone:hover { transform: none; }
  }
</style>
