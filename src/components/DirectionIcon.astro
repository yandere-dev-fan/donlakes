---
/** Слоты icons/{key} — линейные SVG-иконки 1/1. Единый stroke, наследует currentColor. */
interface Props { name: string; class?: string }
const { name, class: className = '' } = Astro.props;
const common = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
---
<span class:list={['dir-icon', className]} aria-hidden="true" set:html={
  {
    cottages: `<svg viewBox="0 0 32 32" ${common}><path d="M6 15 16 6l10 9"/><path d="M8 14v11h16V14"/><path d="M13 25v-6h6v6"/></svg>`,
    waterfront: `<svg viewBox="0 0 32 32" ${common}><circle cx="16" cy="11" r="4.5"/><path d="M4 22c2.4 0 2.4 2 4.8 2S11.2 22 13.6 22 16 24 18.4 24 20.8 22 23.2 22 25.6 24 28 24"/><path d="M4 27c2.4 0 2.4 2 4.8 2S11.2 27 13.6 27 16 29 18.4 29 20.8 27 23.2 27 25.6 29 28 29"/></svg>`,
    gazebo: `<svg viewBox="0 0 32 32" ${common}><path d="M6 12 16 6l10 6"/><path d="M8 12v14M24 12v14"/><path d="M8 12h16"/><path d="M8 26h16"/><path d="M12 26v-6h8v6"/></svg>`,
    fishing: `<svg viewBox="0 0 32 32" ${common}><path d="M6 8v10a8 8 0 0 0 8 8"/><circle cx="6" cy="7" r="1.4"/><path d="M20 22c4 0 6-2 6-4s-2-4-6-4c-3 0-5 2-6 4 1 2 3 4 6 4Z"/><path d="M26 18h1.5"/><circle cx="18" cy="17.4" r="0.8"/></svg>`,
    bbq: `<svg viewBox="0 0 32 32" ${common}><path d="M7 12h18l-2 7a6 6 0 0 1-14 0Z"/><path d="M11 25l-1 3M21 25l1 3"/><path d="M14 8c0-1.5 1-2 1-3M18 8c0-1.5 1-2 1-3"/></svg>`,
    kids: `<svg viewBox="0 0 32 32" ${common}><circle cx="16" cy="8" r="3"/><path d="M16 11v9"/><path d="M9 14h14"/><path d="M16 20l-4 6M16 20l4 6"/></svg>`,
    active: `<svg viewBox="0 0 32 32" ${common}><circle cx="16" cy="16" r="10"/><path d="M16 6c3 3 4 7 0 20M16 6c-3 3-4 7 0 20"/><path d="M6.5 16h19"/></svg>`,
  }[name] ?? `<svg viewBox="0 0 32 32" ${common}><circle cx="16" cy="16" r="9"/></svg>`
} />

<style>
  .dir-icon { display: inline-grid; place-items: center; }
  .dir-icon :global(svg) { width: 100%; height: 100%; display: block; }
</style>
