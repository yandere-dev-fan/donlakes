---
/** Слот brand/logo. Пока — типографический знак + мини-эмблема, заменяется на финальный SVG. */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<a href="#hero" class:list={['logo', className]} aria-label="Донские озёра — на главную">
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="34" height="34" fill="none">
      <circle cx="20" cy="16" r="6.5" fill="currentColor" opacity="0.85" />
      <path d="M4 26c3.2 0 3.2 2.6 6.4 2.6S13.6 26 16.8 26s3.2 2.6 6.4 2.6S26.4 26 29.6 26 32.8 28.6 36 28.6"
        stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity="0.9" />
      <path d="M4 32c3.2 0 3.2 2.6 6.4 2.6S13.6 32 16.8 32s3.2 2.6 6.4 2.6S26.4 32 29.6 32 32.8 34.6 36 34.6"
        stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity="0.55" />
    </svg>
  </span>
  <span class="logo__text">
    <span class="logo__name">Донские&nbsp;озёра</span>
    <span class="logo__sub">база отдыха</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }
  .logo__sub {
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    opacity: 0.7;
    margin-top: 3px;
  }
  @media (max-width: 379px) {
    .logo__sub { display: none; }
    .logo__name { font-size: 1.1rem; }
  }
</style>
