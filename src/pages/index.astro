---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerritoryMap from '../components/TerritoryMap.astro';
import content from '../content/managed.json';
import { money, phoneLabel } from '../lib/format';
const tel = `tel:${content.contact.phone}`;
const photo = (name: string) => `/images/${name}.webp`;
---
<BaseLayout>
<header class="site-header">
  <a class="brand" href="#" aria-label="Донские озёра — на главную"><svg viewBox="0 0 52 44" fill="none" aria-hidden="true"><path d="m7 20 12-13 9 10 6-7 12 13M3 29q11-7 23 0t23 0M3 38q11-7 23 0t23 0" stroke="currentColor" stroke-width="2"/><circle cx="39" cy="6" r="3" fill="currentColor"/></svg><span>Донские озёра<small>БАЗА ОТДЫХА</small></span></a>
  <nav id="navigation" aria-label="Основная навигация"><a href="#stay">Домики</a><a href="#territory">Территория</a><a href="#sauna">Бани</a><a href="#fishing">Рыбалка</a><a href="#contacts">Как добраться</a></nav>
  <a class="header-phone" href={tel}>{phoneLabel(content.contact.phone)} <span>↗</span></a>
  <button class="menu-toggle" aria-label="Открыть меню" aria-expanded="false" aria-controls="navigation"><span></span><span></span></button>
</header>
<main id="main">
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-image"><img src={photo('banya_night2')} alt="Баня у озера в вечернем свете и дорожка к воде" fetchpriority="high" width="1280" height="960"/><div class="hero-image-caption"><span>СВОЙ РИТМ. СВОЙ БЕРЕГ.</span><span>Ростовская область</span></div></div>
  <div class="hero-content"><p class="eyebrow light"><span class="tiny-sun">☼</span> БЛИЖЕ, ЧЕМ КАЖЕТСЯ</p><h1 id="hero-title">Там, где<br/>можно <em>выдохнуть.</em></h1><p class="hero-description">{content.hero.description}</p><a href="#stay" class="button cream">Выбрать свой отдых <span>↗</span></a><div class="hero-bottom"><span class="hero-distance">20 <small>минут от города —<br/>и вы на природе</small></span><a href="#territory" class="hero-map-link">Карта<br/>территории <span>↓</span></a></div></div>
  <button class="sunset-postcard gallery-trigger" data-gallery="sunsets" aria-label="Посмотреть фотографии закатов"><img src={photo('lake/lake11')} alt="Оранжевый закат отражается в озере" width="960" height="1280"/><span>Остаться ради заката <span>↗</span></span></button>
</section>
<div class="amenity-strip"><span>Домики среди деревьев</span><i>✳</i><span>Две бани у воды</span><i>✳</i><span>Рыбалка и тишина</span><i>✳</i><span>Отдых всей семьёй</span></div>
<section class="intro section container" id="about"><p class="eyebrow">ВАШ МАЛЕНЬКИЙ ПОБЕГ ИЗ ГОРОДА</p><div><h2>Не торопиться.<br/>Быть <em>ближе.</em></h2><p>{content.intro.paragraphOne}</p><p>{content.intro.paragraphTwo}</p></div><div class="intro-note"><svg viewBox="0 0 90 72" fill="none" aria-hidden="true"><circle cx="45" cy="26" r="14" stroke="currentColor"/><path d="M45 0v7M45 45v7M19 26h-7M71 26h7M26 7l5 5M64 7l-5 5M12 56q16-9 33 0t33 0M12 67q16-9 33 0t33 0" stroke="currentColor"/></svg><span>Хорошие дни<br/>совсем рядом</span></div></section>
<section class="section container" id="stay"><div class="section-heading"><div><p class="eyebrow">01 / ОСТАТЬСЯ ПОДОЛЬШЕ</p><h2>Свой домик.<br/><em>Своя тишина.</em></h2></div><p>На пару дней или на целую неделю.<br/>Выбирайте, как вам уютнее.</p></div>
<div class="stay-grid">
  <article class="stay-card"><button class="stay-photo gallery-trigger" data-gallery="summer" aria-label="Фото и видео летних домиков"><img src={photo('summer_houses/photo_5280587949303079236_y')} alt="Летние домики среди деревьев" loading="lazy" width="960" height="1280"/><span class="photo-tag">2–3 гостя</span><span class="photo-open">Фото и видео ↗</span></button><div class="stay-title"><h3>Летние домики</h3><span>{money(content.summer.priceTwo)}<small>на двоих</small></span></div><p>{content.summer.description}</p><ul class="chips"><li>Сплит-система</li><li>ТВ</li><li>Общий душ и санузел в 15 м</li></ul><details><summary>Удобства и стоимость <span>+</span></summary><p>{content.summer.amenities}</p><p>На двоих — {money(content.summer.priceTwo)}, на троих — {money(content.summer.priceThree)}. Свободные даты уточняйте при бронировании.</p></details><a class="text-link" href={tel}>Узнать свободные даты <span>↗</span></a></article>
  <article class="stay-card"><button class="stay-photo gallery-trigger" data-gallery="cottages" aria-label="Фотографии срубов"><img src={photo('srub/srub10')} alt="Комната в срубе: большая кровать, диван и деревянные стены" loading="lazy" width="960" height="1280"/><span class="photo-tag">2–4 гостя</span><span class="photo-open">Посмотреть внутри ↗</span></button><div class="stay-title"><h3>Срубы с удобствами</h3><span>{money(content.cottage.priceTwo)}<small>за сутки на двоих</small></span></div><p>{content.cottage.description}</p><ul class="chips"><li>Свой душ и санузел</li><li>Сплит-система</li><li>Веранда</li></ul><details><summary>Удобства и стоимость <span>+</span></summary><p>{content.cottage.amenities}</p><p>{money(content.cottage.priceTwo)} в сутки на двоих. Дополнительное место — {money(content.cottage.extraGuestPrice)}. Вместимость — до 4 гостей.</p></details><a class="text-link" href={tel}>Узнать свободные даты <span>↗</span></a></article>
</div><div class="checkin"><span>Заезд <b>с {content.contact.checkIn}</b></span><span>Выезд <b>до {content.contact.checkOut}</b></span><span>Wi-Fi на всей территории</span><span>Мангал у каждого домика</span><button class="gallery-trigger facilities-link" data-gallery="facilities">Душ, туалет и кухня · фото ↗</button></div>
<div class="stay-conditions" aria-labelledby="stay-conditions-title">
  <h3 id="stay-conditions-title">Заезд, выезд и ещё немного отдыха</h3>
  <div class="conditions-grid">
    <article><h4>Если приезжаете раньше</h4><p>Гарантированный заезд — с {content.contact.checkIn}. Если домик готов, заселим раньше без доплаты. Если ещё занят, заселение — в расчётный час. До этого можно гулять по территории, отдыхать, готовить на мангале и пользоваться всеми активностями.</p></article>
    <article><h4>Если хочется остаться</h4><p>В день выезда домик нужно освободить до {content.contact.checkOut}. После выселения можно остаться на территории до {content.contact.dayEnd}, оплатив дневное пребывание — {money(content.day.price)} с человека. {content.contact.childrenNote}.</p><p>Продлить проживание в домике можно по факту, при наличии свободных мест.</p></article>
  </div>
</div></section>
<section class="map-section section" id="territory"><div class="container"><div class="section-heading"><div><p class="eyebrow">02 / ОСМОТРЕТЬСЯ</p><h2>Здесь всё <em>рядом.</em></h2></div><p>Выберите объект на схеме —<br/>посмотрите описание и фотографии.</p></div><TerritoryMap /></div></section>
<section class="section container experience" id="sauna"><div class="experience-photo"><button class="gallery-trigger" data-gallery="sauna" aria-label="Открыть общую галерею двух бань"><img src={photo('banya/banya7')} alt="Деревянная баня с террасой и видом на озеро" width="960" height="1280" loading="lazy"/><span class="photo-open">Общая галерея двух бань ↗</span></button><span class="vertical-caption">ТЕПЛО, КОТОРОЕ ОСТАЁТСЯ С ВАМИ</span></div><div class="experience-copy"><p class="eyebrow">03 / СОГРЕТЬСЯ</p><h2>Хороший пар.<br/><em>И озеро рядом.</em></h2><p>{content.sauna.description}</p><div class="mini-photos"><button class="gallery-trigger" data-gallery="sauna" data-index="1" aria-label="Фото парной"><img src={photo('banya_parilnaya_komnata')} alt="Деревянная парная" loading="lazy" width="960" height="1280"/></button><button class="gallery-trigger" data-gallery="sauna" data-index="2" aria-label="Фото комнаты отдыха"><img src={photo('banya/banya22')} alt="Комната отдыха с креслами и гирляндами" loading="lazy" width="960" height="1280"/></button></div><p>{content.sauna.brooms}</p><div class="sauna-albums"><button class="gallery-trigger" data-gallery="sauna-winter"><img src={photo('banya_winter/photo_5280587949303079256_y')} alt="Баня зимой" loading="lazy" width="960" height="1280"/><span>Бани зимой ↗</span></button><button class="gallery-trigger" data-gallery="sauna-details"><img src={photo('veniki-drova-furnace/photo_5280587949303079259_y')} alt="Огонь в банной печи" loading="lazy" width="960" height="1280"/><span>Печь и веники ↗</span></button></div><p class="sauna-price">{content.sauna.priceText}</p><a class="text-link" href={tel}>Узнать стоимость и забронировать <span>↗</span></a></div></section>
<section class="fishing-section" id="fishing"><div class="fishing-copy"><p class="eyebrow light">04 / ПОБЫТЬ У ВОДЫ</p><h2>Пусть подождёт<br/><em>всё, кроме клёва.</em></h2><p>{content.fishing.description}</p><p>{content.fishing.conditions}</p><a href={tel} class="button cream">Уточнить условия рыбалки <span>↗</span></a></div><div class="lake-guide"><a href="#territory"><span>РЫБАЛКА</span><strong>Для рыбалки</strong><p>Прибрежные платформы<br/>и места по периметру озера</p></a><a href="#territory"><span>ПЛЯЖ И БАНИ</span><strong>Для купания</strong><p>Пляж на другом берегу,<br/>рядом — волейбольная площадка</p></a></div></section>
<section class="section container" id="day"><div class="section-heading"><div><p class="eyebrow">05 / ПРИЕХАТЬ НА ДЕНЬ</p><h2>Маленькие каникулы.<br/><em>Большой компанией.</em></h2></div><div class="day-price"><strong>{money(content.day.price)}</strong><span>с человека · с {content.contact.dayStart} до {content.contact.dayEnd}<br/>{content.contact.childrenNote}</span></div></div><p class="day-included">Дневное пребывание без проживания — с {content.contact.dayStart} до {content.contact.dayEnd}. {content.day.description}</p><div class="day-grid"><article><button class="gallery-trigger" data-gallery="gazebos" aria-label="Фотографии беседок"><img src={photo('besedki/besedka9')} alt="Беседка со шторами в тени деревьев" width="960" height="1280" loading="lazy"/><span class="photo-open">Смотреть фото ↗</span></button><h3>Собраться за одним столом</h3><p>{content.day.gazebos}</p></article><article><button class="gallery-trigger" data-gallery="kids" aria-label="Фотографии детской площадки и активностей"><img src={photo('misc/playground')} alt="Детская горка на зелёной территории" width="960" height="1280" loading="lazy"/><span class="photo-open">Смотреть фото ↗</span></button><h3>Нагуляться от души</h3><p>{content.day.activities}</p></article><article><button class="gallery-trigger" data-gallery="water" aria-label="Фотографии отдыха у воды"><img src={photo('lake/beach')} alt="Место для отдыха у озера" width="960" height="1280" loading="lazy"/><span class="photo-open">Смотреть фото ↗</span></button><h3>Ничего не планировать</h3><p>{content.day.water}</p></article></div></section>
<section class="contacts-section section" id="contacts"><div class="container contacts-grid"><div><p class="eyebrow light">ДО ВСТРЕЧИ НА БЕРЕГУ</p><h2>Вы ближе<br/><em>к отдыху.</em></h2><p>В 20 минутах от Ростова и Новочеркасска.<br/>Откройте маршрут и приезжайте в «Донские озёра».</p><a class="button cream" href={content.contact.mapUrl} target="_blank" rel="noopener noreferrer">Маршрут в Яндекс Картах <span>↗</span></a></div><div class="contact-card"><p class="eyebrow">СПЛАНИРУЕМ ВАШ ОТДЫХ</p><a class="contact-phone" href={tel}>{phoneLabel(content.contact.phone)}</a><p>{content.contact.description}</p><div class="contact-facts"><div><span>Проживание</span><b>Заезд с {content.contact.checkIn} · выезд до {content.contact.checkOut}</b></div><div><span>Дневной отдых</span><b>С {content.contact.dayStart} до {content.contact.dayEnd}</b></div></div><p class="contact-small">Актуальную стоимость и условия отдыха уточняйте при бронировании.</p></div></div></section>
</main>
<footer class="site-footer container"><a class="footer-brand" href="#">Донские озёра</a><span>Хорошие дни совсем рядом.</span><span>© {new Date().getFullYear()} Донские озёра</span></footer>
<dialog id="gallery-dialog" aria-labelledby="gallery-title"><div class="gallery-top"><span id="gallery-title">Фотографии базы</span><button id="gallery-close" aria-label="Закрыть галерею">✕</button></div><div class="gallery-stage"><button id="gallery-prev" aria-label="Предыдущий кадр">←</button><p id="gallery-error" role="status" hidden>Не удалось загрузить этот кадр. Перейдите к следующему или попробуйте позже.</p><img id="gallery-image" src={photo('banya_night2')} alt=""/><video id="gallery-video" controls playsinline preload="none" hidden aria-label="Видео летних домиков"></video><button id="gallery-next" aria-label="Следующий кадр">→</button></div><div class="gallery-bottom"><span id="gallery-counter"></span><a class="gallery-call" href={tel}>Позвонить на базу ↗</a></div></dialog>
<script>
  import '../lib/site';
</script>
</BaseLayout>
