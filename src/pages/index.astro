---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import Hero from '../components/sections/Hero.astro';
import Directions from '../components/sections/Directions.astro';
import Cottages from '../components/sections/Cottages.astro';
---
<BaseLayout>
  <Header slot="header" />

  <Hero />
  <Directions />
  <Cottages />

  <!--
    Этап B добавит сюда: #map, #banya, #gazebo, #fishing, #kids,
    #prices, #gallery, #reviews, #location, #faq — в порядке спеки.
  -->

  <Footer slot="footer" />
  <CallBar slot="fixed" />
</BaseLayout>
